<Window x:Class="VGT.RhythmGuard.App.SettingsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VGT RhythmGuard"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Width="1480" Height="940"
        MinWidth="1220" MinHeight="780"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        PreviewMouseLeftButtonDown="OnWindowPreviewMouseDown">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource Surface.GlassCompact}">
            <Setter Property="Padding" Value="22" />
        </Style>

        <Style x:Key="KpiCard" TargetType="Border" BasedOn="{StaticResource Surface.GlassCompact}">
            <Setter Property="Padding" Value="20" />
        </Style>

        <Style x:Key="IconCircle" TargetType="Border">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Background" Value="#1FFFFFFF" />
            <Setter Property="BorderBrush" Value="#2AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="Nav.Item" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,2,0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" CornerRadius="13" Background="Transparent" Padding="14,11">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#12FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#24FFFFFF" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#3DFFFFFF" />
                                <Setter TargetName="Root" Property="BorderThickness" Value="1" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowRoot" CornerRadius="26" ClipToBounds="True"
            BorderBrush="{StaticResource Brush.GlassBorder}" BorderThickness="1">
        <Grid>
            <!-- Aurora-Hintergrund -->
            <Rectangle Fill="{StaticResource Brush.Backdrop}" />
            <Canvas IsHitTestVisible="False" ClipToBounds="True">
                <Ellipse Canvas.Left="-260" Canvas.Top="-380" Width="1100" Height="1100">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#7A7C5CFF" Offset="0" />
                            <GradientStop Color="#007C5CFF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Canvas.Left="720" Canvas.Top="-320" Width="1050" Height="1050">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#5C4CC9F0" Offset="0" />
                            <GradientStop Color="#004CC9F0" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Canvas.Left="1080" Canvas.Top="620" Width="980" Height="980">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#48F72585" Offset="0" />
                            <GradientStop Color="#00F72585" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Canvas.Left="260" Canvas.Top="780" Width="760" Height="760">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#3C4FE3C1" Offset="0" />
                            <GradientStop Color="#004FE3C1" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Canvas>
            <Rectangle Fill="#1F000000" />

            <Grid Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ================= SIDEBAR ================= -->
                <Border Grid.Column="0" CornerRadius="24" Background="#14FFFFFF" BorderBrush="#26FFFFFF"
                        BorderThickness="1" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,4,0,26"
                                    MouseLeftButtonDown="OnTitleBarMouseDown">
                            <Image Source="pack://application:,,,/assets/logo-mark.png" Width="46" Height="46"
                                   Stretch="Uniform" />
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="RhythmGuard" FontFamily="{StaticResource Font.Display}"
                                           FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
                                <TextBlock Text="MENTAL RHYTHM" Style="{StaticResource Text.Caption}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="1">
                            <RadioButton x:Name="NavOverview" GroupName="Nav" Style="{StaticResource Nav.Item}"
                                         IsChecked="True" Checked="OnNavChecked" Tag="overview">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="◉" FontSize="15" Width="26" />
                                    <TextBlock Text="Übersicht" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavSettings" GroupName="Nav" Style="{StaticResource Nav.Item}"
                                         Checked="OnNavChecked" Tag="settings">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙" FontSize="15" Width="26" />
                                    <TextBlock Text="Einstellungen" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavHistory" GroupName="Nav" Style="{StaticResource Nav.Item}"
                                         Checked="OnNavChecked" Tag="history">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▤" FontSize="15" Width="26" />
                                    <TextBlock Text="Verlauf" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Margin="0,12,0,14">
                            <Border Style="{StaticResource Surface.Inset}">
                                <StackPanel>
                                    <TextBlock Text="AKTUELLER MODUS" Style="{StaticResource Text.Caption}" />
                                    <TextBlock x:Name="SidebarModeText" FontFamily="{StaticResource Font.Text}"
                                               FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}"
                                               Margin="0,4,0,0" Text="Fokusphase" />
                                    <TextBlock x:Name="SidebarCountdownText" Style="{StaticResource Text.Caption}"
                                               Margin="0,4,0,0" Text="Pause in 01:24:10" />
                                    <Grid Height="3" Background="#1FFFFFFF" Margin="0,10,0,0">
                                        <Border x:Name="SidebarProgressFill" HorizontalAlignment="Left" Width="0"
                                                CornerRadius="2" Background="{StaticResource Brush.AccentGradient}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="4,0,0,2">
                            <Grid Width="36" Height="36">
                                <Ellipse Fill="{StaticResource Brush.GoldGradient}" />
                                <TextBlock Text="R" FontFamily="{StaticResource Font.Display}" FontWeight="Bold"
                                           FontSize="15" Foreground="#1A1038" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="UserNameText" Text="Profil" FontFamily="{StaticResource Font.Text}" FontSize="13.5"
                                           FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
                                <TextBlock Text="Dein Rhythmus-System" Style="{StaticResource Text.Caption}" />
                                <TextBlock x:Name="VersionText" Text="v1.2.0" Style="{StaticResource Text.Caption}"
                                           Foreground="{StaticResource Brush.TextMuted}" Margin="0,3,0,0" />
                                <TextBlock x:Name="PoweredByText" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                                           Foreground="{StaticResource Brush.TextMuted}">
                                    <Run Text="Powered by " />
                                    <Hyperlink NavigateUri="https://visiongaiatechnology.de"
                                               RequestNavigate="OnBrandNavigate"
                                               Foreground="{StaticResource Brush.Mint}">VisionGaiaTechnology</Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ================= MAIN ================= -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="4,2,6,20" MouseLeftButtonDown="OnTitleBarMouseDown">
                        <StackPanel>
                            <TextBlock x:Name="PageTitleText" Text="Übersicht" Style="{StaticResource Text.Headline}" />
                            <TextBlock x:Name="DateCaption" Style="{StaticResource Text.Caption}" Margin="2,6,0,0"
                                       Text="Samstag, 24. Oktober 2026" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border x:Name="TopStatusPill" Background="#2238D9A9" BorderBrush="#5538D9A9"
                                    BorderThickness="1" CornerRadius="12" Padding="12,7" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="TopStatusDot" Width="8" Height="8"
                                             Fill="{StaticResource Brush.AuroraTeal}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TopStatusText" Text="FOKUS" Style="{StaticResource Text.Caption}"
                                               Foreground="{StaticResource Brush.Text}" Margin="8,0,0,0" />
                                </StackPanel>
                            </Border>
                            <Button Style="{StaticResource Button.Primary}" Content="Pause jetzt"
                                    Margin="12,0,0,0" Click="OnPauseNowClick" />
                            <Button Style="{StaticResource Button.Ghost}" Content="—" FontSize="15"
                                    Margin="8,0,0,0" Click="OnMinimizeClick" />
                            <Button Style="{StaticResource Button.Ghost}" Content="×" FontSize="18"
                                    Click="OnCloseClick" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <!-- ============ PAGE: ÜBERSICHT ============ -->
                        <ScrollViewer x:Name="PageOverview" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="4,0,8,24">
                                <!-- KPI-Zeile -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource KpiCard}">
                                        <StackPanel>
                                            <Grid>
                                                <Border Style="{StaticResource IconCircle}">
                                                    <TextBlock Text="◷" FontSize="17" Foreground="{StaticResource Brush.AuroraTeal}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="NÄCHSTE PAUSE" Style="{StaticResource Text.Caption}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock x:Name="KpiNextBreakText" FontFamily="{StaticResource Font.Display}"
                                                       FontSize="36" FontWeight="Light" Foreground="{StaticResource Brush.Text}"
                                                       Margin="0,14,0,0" Text="01:24:10" />
                                            <TextBlock x:Name="KpiNextBreakCaption" Style="{StaticResource Text.Caption}"
                                                       Margin="0,4,0,0" Text="danach 30 Minuten Ruhe" />
                                            <Grid Height="3" Background="#1FFFFFFF" Margin="0,12,0,0">
                                                <Border x:Name="KpiBreakProgressFill" HorizontalAlignment="Left" Width="0"
                                                        CornerRadius="2" Background="{StaticResource Brush.AccentGradient}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource KpiCard}">
                                        <StackPanel>
                                            <Grid>
                                                <Border Style="{StaticResource IconCircle}">
                                                    <TextBlock Text="✓" FontSize="16" Foreground="{StaticResource Brush.AuroraTeal}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="PAUSEN HEUTE" Style="{StaticResource Text.Caption}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock x:Name="KpiBreaksTodayText" FontFamily="{StaticResource Font.Display}"
                                                       FontSize="36" FontWeight="Light" Foreground="{StaticResource Brush.Text}"
                                                       Margin="0,14,0,0" Text="3" />
                                            <TextBlock x:Name="KpiBreaksTodayCaption" Style="{StaticResource Text.Caption}"
                                                       Margin="0,4,0,0" Text="diese Woche: 11" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="4" Style="{StaticResource KpiCard}">
                                        <StackPanel>
                                            <Grid>
                                                <Border Style="{StaticResource IconCircle}">
                                                    <TextBlock Text="☾" FontSize="16" Foreground="{StaticResource Brush.Gold}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="ABENDMODUS" Style="{StaticResource Text.Caption}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock x:Name="KpiEveningText" FontFamily="{StaticResource Font.Display}"
                                                       FontSize="36" FontWeight="Light" Foreground="{StaticResource Brush.Text}"
                                                       Margin="0,14,0,0" Text="in 6h" />
                                            <TextBlock x:Name="KpiEveningCaption" Style="{StaticResource Text.Caption}"
                                                       Margin="0,4,0,0" Text="Erinnerungen alle 20 Min" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="6" Style="{StaticResource KpiCard}">
                                        <StackPanel>
                                            <Grid>
                                                <Border Style="{StaticResource IconCircle}">
                                                    <TextBlock Text="✦" FontSize="17" Foreground="{StaticResource Brush.AuroraPink}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="STREAK" Style="{StaticResource Text.Caption}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock x:Name="KpiStreakText" FontFamily="{StaticResource Font.Display}"
                                                       FontSize="36" FontWeight="Light" Foreground="{StaticResource Brush.Text}"
                                                       Margin="0,14,0,0" Text="4" />
                                            <TextBlock x:Name="KpiStreakCaption" Style="{StaticResource Text.Caption}"
                                                       Margin="0,4,0,0" Text="Tage mit Pausen" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Chart + Ring -->
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource Card}">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="Tagesrhythmus" Style="{StaticResource Text.Subhead}"
                                                           FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Ellipse Width="7" Height="7" Fill="{StaticResource Brush.AuroraViolet}"
                                                             VerticalAlignment="Center" />
                                                    <TextBlock Text="Fokus" Style="{StaticResource Text.Caption}" Margin="6,0,14,0"
                                                               VerticalAlignment="Center" />
                                                    <Ellipse Width="7" Height="7" Fill="{StaticResource Brush.AuroraTeal}"
                                                             VerticalAlignment="Center" />
                                                    <TextBlock Text="Pause" Style="{StaticResource Text.Caption}" Margin="6,0,0,0"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                            <Canvas x:Name="RhythmChartCanvas" Height="216" Margin="0,16,0,0"
                                                    Background="Transparent" ClipToBounds="True" />
                                            <Grid Margin="2,8,2,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="ChartAxisText1" Style="{StaticResource Text.Caption}"
                                                           Text="07:00" HorizontalAlignment="Left" />
                                                <TextBlock x:Name="ChartAxisText2" Grid.Column="1"
                                                           Style="{StaticResource Text.Caption}" Text="12:00"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock x:Name="ChartAxisText3" Grid.Column="2"
                                                           Style="{StaticResource Text.Caption}" Text="17:00"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock x:Name="ChartAxisText4" Grid.Column="3"
                                                           Style="{StaticResource Text.Caption}" Text="23:00"
                                                           HorizontalAlignment="Right" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="Tagesziel" Style="{StaticResource Text.Subhead}"
                                                       FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
                                            <Grid Width="196" Height="196" HorizontalAlignment="Center" Margin="0,10,0,0">
                                                <Canvas x:Name="RingCanvas" Width="196" Height="196" />
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock x:Name="RingPercentText" FontFamily="{StaticResource Font.Display}"
                                                               FontSize="34" FontWeight="Light" Foreground="{StaticResource Brush.Text}"
                                                               HorizontalAlignment="Center" Text="58%" />
                                                    <TextBlock Text="Rhythmus-Score" Style="{StaticResource Text.Caption}"
                                                               HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Margin="0,8,0,0">
                                                <Grid Margin="0,4,0,0">
                                                    <TextBlock Text="Pausen" Style="{StaticResource Text.Body}" />
                                                    <TextBlock x:Name="MetricBreaksText" Style="{StaticResource Text.Label}"
                                                               HorizontalAlignment="Right" Text="3 / 6" />
                                                </Grid>
                                                <Grid Margin="0,8,0,0">
                                                    <TextBlock Text="Abbrüche" Style="{StaticResource Text.Body}" />
                                                    <TextBlock x:Name="MetricAbortedText" Style="{StaticResource Text.Label}"
                                                               HorizontalAlignment="Right" Text="0" />
                                                </Grid>
                                                <Grid Margin="0,8,0,0">
                                                    <TextBlock Text="Abend-Erinnerungen" Style="{StaticResource Text.Body}" />
                                                    <TextBlock x:Name="MetricRemindersText" Style="{StaticResource Text.Label}"
                                                               HorizontalAlignment="Right" Text="0" />
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Events + Systemstatus -->
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.6*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource Card}">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="Letzte Ereignisse" Style="{StaticResource Text.Subhead}"
                                                           FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
                                                <TextBlock Text="HEUTE" Style="{StaticResource Text.Caption}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                            <StackPanel x:Name="EventsList" Margin="0,12,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="Systemstatus" Style="{StaticResource Text.Subhead}"
                                                       FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
                                            <Grid Margin="0,16,0,0">
                                                <TextBlock Text="Rhythmus-Engine" Style="{StaticResource Text.Body}" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Ellipse Width="7" Height="7" Fill="{StaticResource Brush.AuroraTeal}"
                                                             VerticalAlignment="Center" />
                                                    <TextBlock Text="aktiv" Style="{StaticResource Text.Caption}" Margin="6,0,0,0" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,12,0,0">
                                                <TextBlock Text="Abendmodus" Style="{StaticResource Text.Body}" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Ellipse x:Name="StatusEveningDot" Width="7" Height="7"
                                                             Fill="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="StatusEveningText" Text="inaktiv"
                                                               Style="{StaticResource Text.Caption}" Margin="6,0,0,0" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,12,0,0">
                                                <TextBlock Text="Bett-Modus" Style="{StaticResource Text.Body}" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Ellipse x:Name="StatusBedDot" Width="7" Height="7"
                                                             Fill="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="StatusBedText" Text="inaktiv"
                                                               Style="{StaticResource Text.Caption}" Margin="6,0,0,0" />
                                                </StackPanel>
                                            </Grid>
                                            <Border Height="1" Background="#1FFFFFFF" Margin="0,16,0,14" />
                                            <CheckBox x:Name="AutostartCheck" Style="{StaticResource Switch.Check}"
                                                      Content="Mit Windows starten" Checked="OnSliderChanged"
                                                      Unchecked="OnSliderChanged" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ============ PAGE: EINSTELLUNGEN ============ -->
                        <ScrollViewer x:Name="PageSettings" Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="4,0,8,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="Tagesrhythmus" Style="{StaticResource Text.Subhead}"
                                                       FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
                                            <Grid Margin="0,16,0,0">
                                                <TextBlock Text="Aktives Fenster" Style="{StaticResource Text.Body}" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <TextBox x:Name="DayStartBox" Style="{StaticResource Input.Text}" Width="96"
                                                             Padding="10,8" TextAlignment="Center" Text="07:00" />
                                                    <TextBlock Text="–" Style="{StaticResource Text.Body}" Margin="8,0,8,0"
                                                               VerticalAlignment="Center" />
                                                    <TextBox x:Name="DayEndBox" Style="{StaticResource Input.Text}" Width="96"
                                                             Padding="10,8" TextAlignment="Center" Text="23:00" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,18,0,0">
                                                <TextBlock Text="Fokusphase" Style="{StaticResource Text.Body}" />
                                                <TextBlock x:Name="WorkValueText" Style="{StaticResource Text.Label}"
                                                           HorizontalAlignment="Right" Text="120 Min" />
                                            </Grid>
                                            <Slider x:Name="WorkSlider" Style="{StaticResource Slider.Glass}" Minimum="30"
                                                    Maximum="240" TickFrequency="15" IsSnapToTickEnabled="True" Value="120"
                                                    ValueChanged="OnSliderChanged" />
                                            <Grid Margin="0,10,0,0">
                                                <TextBlock Text="Pause" Style="{StaticResource Text.Body}" />
                                                <TextBlock x:Name="BreakValueText" Style="{StaticResource Text.Label}"
                                                           HorizontalAlignment="Right" Text="30 Min" />
                                            </Grid>
                                            <Slider x:Name="BreakSlider" Style="{StaticResource Slider.Glass}" Minimum="5"
                                                    Maximum="60" TickFrequency="5" IsSnapToTickEnabled="True" Value="30"
                                                    ValueChanged="OnSliderChanged" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="Abendmodus" Style="{StaticResource Text.Subhead}"
                                                       FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
                                            <CheckBox x:Name="EveningEnabledCheck" Style="{StaticResource Switch.Check}"
                                                      Content="Erinnerungen nach 23:00 anzeigen" IsChecked="True"
                                                      Checked="OnSliderChanged" Unchecked="OnSliderChanged" Margin="0,14,0,0" />
                                            <Grid Margin="0,18,0,0">
                                                <TextBlock Text="Erinnerungs-Intervall" Style="{StaticResource Text.Body}" />
                                                <TextBlock x:Name="EveningValueText" Style="{StaticResource Text.Label}"
                                                           HorizontalAlignment="Right" Text="20 Min" />
                                            </Grid>
                                            <Slider x:Name="EveningSlider" Style="{StaticResource Slider.Glass}" Minimum="5"
                                                    Maximum="60" TickFrequency="5" IsSnapToTickEnabled="True" Value="20"
                                                    ValueChanged="OnSliderChanged" />
                                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                                                       Text="Tipp: „Nur noch anschauen“ startet direkt den Bett-Modus." />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="Bett-Modus" Style="{StaticResource Text.Subhead}"
                                                       FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
                                            <Grid Margin="0,16,0,0">
                                                <TextBlock Text="Dauer bis Energie-Aktion" Style="{StaticResource Text.Body}" />
                                                <TextBlock x:Name="BedValueText" Style="{StaticResource Text.Label}"
                                                           HorizontalAlignment="Right" Text="120 Min" />
                                            </Grid>
                                            <Slider x:Name="BedSlider" Style="{StaticResource Slider.Glass}" Minimum="15"
                                                    Maximum="240" TickFrequency="15" IsSnapToTickEnabled="True" Value="120"
                                                    ValueChanged="OnSliderChanged" />
                                            <TextBlock Text="Aktion danach" Style="{StaticResource Text.Label}" Margin="0,16,0,8" />
                                            <WrapPanel>
                                                <RadioButton x:Name="ActionSleep" GroupName="PowerAction"
                                                             Style="{StaticResource Chip.Radio}" Content="Ruhezustand"
                                                             Checked="OnSliderChanged" />
                                                <RadioButton x:Name="ActionHibernate" GroupName="PowerAction"
                                                             Style="{StaticResource Chip.Radio}" Content="Hibernate"
                                                             Checked="OnSliderChanged" />
                                                <RadioButton x:Name="ActionShutdownSoft" GroupName="PowerAction"
                                                             Style="{StaticResource Chip.Radio}" Content="Sanft herunterfahren"
                                                             Checked="OnSliderChanged" />
                                                <RadioButton x:Name="ActionShutdownHard" GroupName="PowerAction"
                                                             Style="{StaticResource Chip.Radio}" Content="Hart herunterfahren"
                                                             Checked="OnSliderChanged" />
                                            </WrapPanel>
                                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,10,0,0" TextWrapping="Wrap"
                                                       Text="Vor dem Herunterfahren erscheint eine Warnung mit Countdown." />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="Notausstieg" Style="{StaticResource Text.Subhead}"
                                                       FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
                                            <Grid Margin="0,16,0,0">
                                                <TextBlock Text="ESC-Haltezeit" Style="{StaticResource Text.Body}" />
                                                <TextBlock x:Name="EmergencyValueText" Style="{StaticResource Text.Label}"
                                                           HorizontalAlignment="Right" Text="5 Sek" />
                                            </Grid>
                                            <Slider x:Name="EmergencySlider" Style="{StaticResource Slider.Glass}" Minimum="0"
                                                    Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Value="5"
                                                    ValueChanged="OnSliderChanged" />
                                            <TextBlock x:Name="EmergencyHint" Style="{StaticResource Text.Caption}"
                                                       Margin="0,8,0,0" TextWrapping="Wrap" />

                                            <Border Height="1" Background="#1FFFFFFF" Margin="0,18,0,16" />
                                            <TextBlock Text="Sprache" Style="{StaticResource Text.Label}" Margin="0,0,0,8" />
                                            <ComboBox x:Name="LanguageCombo" Height="34" FontFamily="{StaticResource Font.Text}"
                                                      FontSize="13" Background="#1AFFFFFF" Foreground="{StaticResource Brush.Text}"
                                                      BorderBrush="#33FFFFFF">
                                                <ComboBoxItem Content="Systemsprache" Tag="system" />
                                                <ComboBoxItem Content="Deutsch" Tag="de" />
                                                <ComboBoxItem Content="English" Tag="en" />
                                                <ComboBoxItem Content="Español" Tag="es" />
                                                <ComboBoxItem Content="Italiano" Tag="it" />
                                                <ComboBoxItem Content="Русский" Tag="ru" />
                                                <ComboBoxItem Content="中文" Tag="zh" />
                                                <ComboBoxItem Content="日本語" Tag="ja" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,18,0,0">
                                <TextBlock x:Name="ErrorText" Foreground="{StaticResource Brush.Danger}"
                                           FontFamily="{StaticResource Font.Text}" FontSize="12.5" VerticalAlignment="Center"
                                           Text="" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="Einstellungen werden beim Speichern übernommen."
                                               Style="{StaticResource Text.Caption}" VerticalAlignment="Center"
                                               Margin="0,0,16,0" />
                                    <Button x:Name="SaveButton" Style="{StaticResource Button.Primary}" Content="Speichern"
                                            Click="OnSaveClick" />
                                </StackPanel>
                            </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ============ PAGE: VERLAUF ============ -->
                        <ScrollViewer x:Name="PageHistory" Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Border Style="{StaticResource Card}" Margin="4,0,8,24">
                                <StackPanel>
                                    <TextBlock Text="Verlauf" Style="{StaticResource Text.Subhead}" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Text}" />
                                    <TextBlock Text="Alle protokollierten Rhythmus-Ereignisse der letzten Tage."
                                               Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
                                    <StackPanel x:Name="HistoryList" Margin="0,16,0,0" />
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
