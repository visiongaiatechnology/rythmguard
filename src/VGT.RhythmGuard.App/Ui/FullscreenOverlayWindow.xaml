<Window x:Class="VGT.RhythmGuard.App.Ui.FullscreenOverlayWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VGT RhythmGuard"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStartupLocation="Manual"
        ShowActivated="True"
        Focusable="True">

    <Grid x:Name="RootGrid">
        <Image x:Name="BackdropImage" Stretch="Fill" Opacity="0.55">
            <Image.Effect>
                <BlurEffect Radius="64" KernelType="Gaussian" />
            </Image.Effect>
        </Image>

        <Rectangle Fill="{StaticResource Brush.Backdrop}" Opacity="0.9" />

        <Canvas IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Canvas.Left="-300" Canvas.Top="-360" Width="1100" Height="1100">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#5E7C5CFF" Offset="0" />
                        <GradientStop Color="#007C5CFF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Canvas.Left="1150" Canvas.Top="-200" Width="1000" Height="1000">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#3D4CC9F0" Offset="0" />
                        <GradientStop Color="#004CC9F0" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Canvas.Left="900" Canvas.Top="600" Width="1000" Height="1000">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#2EF72585" Offset="0" />
                        <GradientStop Color="#00F72585" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <Border HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620"
                Style="{StaticResource Surface.Glass}" Padding="58,48">
            <StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <Image Source="pack://application:,,,/assets/logo-wordmark.png" Height="42"
                           Stretch="Uniform" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Mint}" VerticalAlignment="Center">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="{StaticResource Color.Mint}" BlurRadius="18" ShadowDepth="0" Opacity="0.9" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock x:Name="ModeCaption" Style="{StaticResource Text.Caption}" Margin="10,0,0,0"
                                   VerticalAlignment="Center" Text="ERZWUNGENE PAUSE" />
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="TitleText" Style="{StaticResource Text.Headline}" FontSize="34"
                           HorizontalAlignment="Center" Margin="0,20,0,0" TextAlignment="Center" Text="Zeit für dich." />

                <TextBlock x:Name="CountdownText" Style="{StaticResource Text.Display}" HorizontalAlignment="Center"
                           Margin="0,4,0,0" Text="30:00" />

                <TextBlock x:Name="SubtitleText" Style="{StaticResource Text.Subhead}" HorizontalAlignment="Center"
                           MaxWidth="440" TextAlignment="Center" Margin="0,2,0,0"
                           Text="Der Bildschirm bleibt aus. Steh auf, atme, trink Wasser." />

                <Border x:Name="SuggestionPanel" Style="{StaticResource Surface.Inset}" Margin="0,28,0,0"
                        HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource Brush.Gold}" VerticalAlignment="Center" />
                        <TextBlock x:Name="SuggestionText" Style="{StaticResource Text.Body}" Margin="10,0,0,0"
                                   Text="Augen schließen und zehnmal tief durchatmen." />
                    </StackPanel>
                </Border>

                <Grid x:Name="ProgressTrack" Height="4" Margin="0,32,0,0" Background="#1FFFFFFF">
                    <Border x:Name="ProgressFill" HorizontalAlignment="Left" CornerRadius="2"
                            Background="{StaticResource Brush.AccentGradient}" Width="0" />
                </Grid>

                <StackPanel x:Name="EmergencyPanel" Orientation="Horizontal" HorizontalAlignment="Center"
                            Margin="0,26,0,0">
                    <TextBlock Text="Notausstieg: ESC 5 Sekunden halten" Style="{StaticResource Text.Caption}"
                               VerticalAlignment="Center" />
                    <Border Width="96" Height="4" Background="#1FFFFFFF" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Border x:Name="EmergencyProgressFill" HorizontalAlignment="Left" CornerRadius="2"
                                Background="{StaticResource Brush.Danger}" Width="0" />
                    </Border>
                </StackPanel>

                <TextBlock x:Name="HintText" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center"
                           Margin="0,22,0,0" Text="VGT RhythmGuard · Dein Rhythmus hat Vorrang vor dem Bildschirm." />
            </StackPanel>
        </Border>
    </Grid>
</Window>
