<Window x:Class="VGT.RhythmGuard.App.Ui.SplashWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VGT RythmGuard"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Width="600" Height="380"
        ShowActivated="False"
        Focusable="False">

    <Border CornerRadius="30" Background="#F0140F2E" BorderBrush="#3DFFFFFF" BorderThickness="1"
            Padding="44,36">
        <Grid>
            <!-- Aurora-Glow -->
            <Canvas IsHitTestVisible="False" ClipToBounds="True">
                <Ellipse Canvas.Left="-180" Canvas.Top="-220" Width="520" Height="520">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#667C5CFF" Offset="0" />
                            <GradientStop Color="#007C5CFF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Canvas.Left="300" Canvas.Top="120" Width="480" Height="480">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#4A4CC9F0" Offset="0" />
                            <GradientStop Color="#004CC9F0" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Canvas>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Source="pack://application:,,,/assets/logo-wordmark.png" Height="92"
                       Stretch="Uniform" HorizontalAlignment="Center" />
                <TextBlock Text="PROTECT YOUR RHYTHM. PROTECT YOURSELF." FontFamily="{StaticResource Font.Text}"
                           FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextMuted}"
                           HorizontalAlignment="Center" Margin="0,10,0,0" />

                <Grid Width="280" Height="3" Margin="0,30,0,0" Background="#1FFFFFFF" ClipToBounds="True">
                    <Border Width="90" CornerRadius="2" Background="{StaticResource Brush.AccentGradient}"
                            HorizontalAlignment="Left">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="ProgressTransform" />
                        </Border.RenderTransform>
                    </Border>
                </Grid>

                <TextBlock x:Name="StatusText" Text="Dein Rhythmus wird vorbereitet …"
                           Style="{StaticResource Text.Caption}" HorizontalAlignment="Center"
                           Margin="0,18,0,0" />
            </StackPanel>

            <TextBlock x:Name="VersionText" Text="v1.1.0" Style="{StaticResource Text.Caption}"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="11" />
        </Grid>
    </Border>
</Window>
