<Window x:Class="VGT.RhythmGuard.App.Ui.EmergencyConfirmWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notausstieg bestätigen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        WindowStartupLocation="CenterOwner">

    <Border Style="{StaticResource Surface.Glass}" Width="540" Padding="34,30" Background="#F7150F33">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Danger}" VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource Text.Caption}" Margin="10,0,0,0" VerticalAlignment="Center"
                           Text="NOTAUSSTIEG" />
            </StackPanel>

            <TextBlock Style="{StaticResource Text.Headline}" FontSize="27" Margin="0,16,0,0"
                       Text="Pause wirklich abbrechen?" />
            <TextBlock Style="{StaticResource Text.Body}" Margin="0,10,0,0"
                       Text="Der Notausstieg ist für echte Ausnahmen gedacht. Wenn du ihn nutzt, verliert der Rhythmus für heute an Wirkung." />

            <TextBlock Style="{StaticResource Text.Label}" Margin="0,20,0,6"
                       Text="Tippe PAUSE zur Bestätigung:" />
            <TextBox x:Name="ConfirmInput" Style="{StaticResource Input.Text}" Width="240" HorizontalAlignment="Left"
                     TextChanged="OnConfirmTextChanged" />

            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                <Button Style="{StaticResource Button.Secondary}" Click="OnCancelClick" Content="Weitermachen" />
                <Button x:Name="ConfirmButton" Style="{StaticResource Button.Primary}" Margin="10,0,0,0"
                        IsEnabled="False" Click="OnConfirmClick" Content="Notausstieg bestätigen" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
