<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\VGT.RhythmGuard.Core\VGT.RhythmGuard.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Marken-Assets (Icon/Wordmark) werden als WPF-Ressourcen eingebettet. -->
    <Resource Include="assets\logo-mark.png" />
    <Resource Include="assets\logo-wordmark.png" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>VGT.RhythmGuard</AssemblyName>
    <RootNamespace>VGT.RhythmGuard.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <Platforms>AnyCPU;x64</Platforms>
    <Version>1.2.0</Version>
    <Company>VisionGaiaTechnology</Company>
    <Product>VGT RhythmGuard</Product>
    <Description>Mental-Health-Rhythmus-System für Windows: erzwungene Pausen, Abendmodus, Bett-Modus.</Description>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- UI-Layer: literale deutsche Texte sind Produktinhalt; WinForms-Analyzer greift bei unserem
         Manifest-DPI (WPF PerMonitorV2). Verwerfbarkeit übernimmt der WPF-Lebenszyklus. -->
    <NoWarn>$(NoWarn);CA1303;CA1416;CA2007;CA1001;CA1822;CA1852;CA1861;WFO0003</NoWarn>
  </PropertyGroup>

</Project>
